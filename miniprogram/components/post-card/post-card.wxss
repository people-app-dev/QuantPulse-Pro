.post-card { background: #fff; border-radius: 12px; padding: 12px; margin-bottom: 10px; }
.post-header { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
.avatar { width: 24px; height: 24px; border-radius: 12px; background: #e0e0e0; }
.user-name { font-size: 12px; font-weight: 600; color: #000; }
.post-time { font-size: 10px; color: #8E8E93; }
.post-content { font-size: 12px; color: #3C3C43; line-height: 1.5; }
.post-images { display: flex; gap: 4px; margin-top: 6px; flex-wrap: wrap; }
.post-image { width: 80px; height: 80px; border-radius: 6px; }
.post-tags { display: flex; gap: 4px; margin-top: 6px; flex-wrap: wrap; }
.tag { font-size: 10px; color: #007AFF; background: #EBF2FF; padding: 2px 8px; border-radius: 8px; }
.post-actions { display: flex; gap: 16px; margin-top: 8px; font-size: 10px; color: #8E8E93; }
.action { cursor: pointer; }
