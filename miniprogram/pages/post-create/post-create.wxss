@import '/styles/design-tokens.wxss';
.page { padding: var(--space-lg); min-height: 100vh; }
.content-input { width: 100%; min-height: 120px; background: var(--color-card); border-radius: var(--radius-card); padding: var(--space-md); font-size: var(--font-body); box-sizing: border-box; }
.image-grid { display: flex; gap: 8px; flex-wrap: wrap; margin-top: var(--space-md); }
.image-item { width: 80px; height: 80px; border-radius: 8px; overflow: hidden; position: relative; }
.image-item image { width: 100%; height: 100%; }
.remove-btn { position: absolute; top: 2px; right: 2px; width: 18px; height: 18px; border-radius: 9px; background: rgba(0,0,0,0.5); color: #fff; font-size: 10px; display: flex; align-items: center; justify-content: center; }
.image-add { width: 80px; height: 80px; border-radius: 8px; border: 1px dashed var(--color-border); display: flex; align-items: center; justify-content: center; font-size: 28px; color: var(--color-border); }
.tag-section { margin-top: var(--space-lg); }
.section-label { font-size: var(--font-caption); color: var(--color-text-secondary); margin-bottom: var(--space-sm); display: block; }
.tag-grid { display: flex; gap: 8px; flex-wrap: wrap; }
.tag { padding: 4px 12px; border-radius: 12px; font-size: var(--font-caption); background: var(--color-card); color: var(--color-text-secondary); }
.tag.active { background: var(--color-primary); color: #fff; }
.submit-btn { margin-top: var(--space-xl); background: var(--color-primary); color: #fff; border-radius: var(--radius-button); font-size: var(--font-body); padding: var(--space-md); border: none; width: 100%; }
