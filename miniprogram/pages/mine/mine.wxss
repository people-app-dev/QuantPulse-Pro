@import '/styles/design-tokens.wxss';

page { background-color: var(--color-bg); }

.page {
  background-color: var(--color-bg);
  padding: var(--space-lg);
  min-height: 100vh;
  padding-bottom: 60px;
}

/* Guest banner */
.guest-banner {
  background: var(--color-card); border-radius: 14px;
  padding: 28px 20px; text-align: center; margin-bottom: 16px;
}
.guest-hint {
  font-size: 15px; color: var(--color-text-secondary); display: block;
  margin-bottom: 14px;
}
.guest-btn {
  background: var(--color-primary); color: #fff; border-radius: 10px;
  font-size: 15px; font-weight: 600; padding: 10px 32px; border: none;
  display: inline-block; width: auto;
}
.guest-btn::after { border: none; }

/* Profile — centered */
.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32px 0 20px;
}
.avatar-wrap {
  width: 80px;
  margin: 0 auto 14px auto;
}
.avatar-btn {
  width: 80px; height: 80px; border-radius: 40px;
  padding: 0; margin: 0; border: none; background: transparent;
  line-height: 1; overflow: hidden;
  display: block;
}
.avatar-btn::after { border: none; }
.avatar { width: 80px; height: 80px; border-radius: 40px; display: block; }
.avatar-pl {
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #007AFF, #5856D6);
}
.avatar-initial { font-size: 32px; font-weight: 600; color: #fff; line-height: 1; }
.nickname-input {
  font-size: 18px; font-weight: 600; color: var(--color-text-primary);
  background: transparent; border: none; padding: 0; width: 200px;
  line-height: 1.3; text-align: center; margin-bottom: 8px;
}
.type-badge {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
}
.type-name {
  font-size: 17px;
  font-weight: 700;
  color: var(--color-text-primary);
}
.type-score {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-primary);
  background: rgba(0,122,255,0.08);
  border-radius: 10px;
  padding: 2px 10px;
}
.profile-subtitle.muted {
  font-size: 13px;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4px;
}
.phone-display {
  font-size: 13px;
  color: var(--color-text-secondary);
  display: block;
  margin-bottom: 6px;
}

/* Allocation card */
.allocation-card {
  background: var(--color-card);
  border-radius: 16px;
  padding: 16px 20px;
  margin-bottom: 8px;
}
.card-heading {
  font-size: 15px;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 14px;
}
.allocation-bar { margin-bottom: 12px; }
.bar-header {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: var(--color-text-body);
  margin-bottom: 4px;
}
.bar-track {
  height: 5px;
  background: var(--color-border);
  border-radius: 2.5px;
}
.bar-fill {
  height: 5px;
  border-radius: 2.5px;
}
.volatility-text {
  font-size: 12px;
  color: var(--color-text-secondary);
  display: block;
  margin-top: 4px;
}

/* Advice card */
.advice-card {
  background: var(--color-card);
  border-radius: 16px;
  padding: 16px 20px;
  margin-bottom: 8px;
}
.advice-subhead {
  font-size: 13px;
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-top: 16px;
  margin-bottom: 8px;
}
.advice-para { margin-bottom: 10px; }
.advice-para-text {
  font-size: 14px;
  color: var(--color-text-body);
  line-height: 1.6;
}
.advice-tags { display: flex; flex-wrap: wrap; gap: 6px; }
.advice-tag {
  background: rgba(0,122,255,0.08);
  border-radius: 6px;
  padding: 4px 10px;
  font-size: 12px;
  color: var(--color-primary);
}
.tag-green { background: rgba(52,199,89,0.08); color: #34C759; }
.tag-red { background: rgba(255,59,48,0.08); color: #FF3B30; }

.disclaimer-inline { text-align: center; padding: 12px 0 4px; }
.disclaimer-small { font-size: 10px; color: var(--color-text-secondary); opacity: 0.6; }

/* Menu — iOS grouped table */
.menu-group {
  background: var(--color-card);
  border-radius: 16px;
  overflow: hidden;
  margin-top: 8px;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 15px 16px;
  border-bottom: 1px solid var(--color-bg);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon-wrap {
  width: 36px; height: 36px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  margin-right: 12px; flex-shrink: 0;
}
.menu-symbol { font-size: 20px; line-height: 1; }
.menu-label { flex: 1; font-size: 16px; color: var(--color-text-primary); }
.menu-arrow { font-size: 20px; color: #C7C7CC; flex-shrink: 0; }

/* Quote */
.quote-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32px 0 24px;
}
.quote-line {
  font-size: 14px;
  color: #C7C7CC;
  letter-spacing: 2px;
  line-height: 1.8;
}
