<view class="page">
  <view class="profile-header">
    <image class="avatar" src="{{userInfo.avatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="profile-info">
      <text class="nickname">{{userInfo.nickname || '用户'}}</text>
      <text class="investor-type" wx:if="{{userInfo.investorType}}">{{userInfo.investorType}}</text>
      <text class="investor-type empty" wx:else>未测评</text>
    </view>
    <view class="refresh-btn" bindtap="onRefreshLogin">
      <text class="refresh-text">重试登录</text>
    </view>
  </view>

  <view class="stats-row" wx:if="{{userInfo.riskScore}}">
    <view class="stat-item">
      <text class="stat-value">{{userInfo.riskScore}}</text>
      <text class="stat-label">风险评分</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{assessmentCount}}</text>
      <text class="stat-label">测评次数</text>
    </view>
  </view>

  <view class="menu-list">
    <view class="menu-item" wx:for="{{menuItems}}" wx:key="key" bindtap="onMenuTap" data-key="{{item.key}}">
      <text>{{item.label}}</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
