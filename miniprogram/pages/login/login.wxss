@import '/styles/design-tokens.wxss';

page { background-color: var(--color-bg); }

.page {
  background-color: var(--color-bg);
  min-height: 100vh;
  padding: 80px 24px 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Brand */
.brand { text-align: center; margin-bottom: 40px; }
.brand-name {
  font-size: 36px; font-weight: 800; color: var(--color-text-primary);
  letter-spacing: -0.5px; display: block;
}
.brand-sub {
  display: block; font-size: 14px; color: var(--color-text-secondary);
  margin-top: 6px; letter-spacing: 1px;
}

/* Mode tabs */
.mode-tabs {
  display: flex; width: 100%; max-width: 320px;
  background: var(--color-card); border-radius: 10px;
  padding: 3px; margin-bottom: 16px;
}
.mode-tab {
  flex: 1; text-align: center; padding: 9px 0; border-radius: 8px;
  font-size: 15px; font-weight: 500; color: var(--color-text-secondary);
  transition: all 0.15s;
}
.mode-tab.active {
  background: var(--color-primary); color: #fff; font-weight: 600;
  box-shadow: 0 1px 4px rgba(0,122,255,0.3);
}

/* Card base */
.card {
  width: 100%; max-width: 320px;
  background: var(--color-card); border-radius: 14px;
  padding: 20px; margin-bottom: 16px;
}

/* WeChat button */
.wechat-btn {
  width: 100%; background: #07C160; color: #fff;
  border-radius: 12px; padding: 15px; border: none;
  display: flex; align-items: center; justify-content: center;
  gap: 8px; font-size: 16px; font-weight: 600;
}
.wechat-btn::after { border: none; }
.wechat-icon { font-size: 18px; line-height: 1; }
.wechat-text { font-size: 16px; font-weight: 600; line-height: 1; }

/* Separator */
.sep-row {
  display: flex; align-items: center; gap: 12px;
  margin-top: 18px;
}
.sep-line { flex: 1; height: 1px; background: var(--color-border); }
.sep-label {
  font-size: 12px; color: var(--color-text-secondary);
  flex-shrink: 0;
}

/* Form fields — iOS inset grouped style */
.form-card { padding: 2px 0; }
.field-row {
  display: flex; align-items: center;
  padding: 0 16px; height: 48px;
  border-bottom: 1px solid var(--color-bg);
}
.field-row:last-child { border-bottom: none; }
.field-prefix {
  font-size: 16px; font-weight: 500; color: var(--color-text-secondary);
  margin-right: 12px;
}
.field-divider {
  width: 1px; height: 18px; background: var(--color-border);
  margin-right: 12px;
}
.field-input {
  flex: 1; font-size: 16px; color: var(--color-text-primary);
  background: transparent; border: none; height: 100%;
}

/* Action button */
.action-btn {
  width: 100%; max-width: 320px;
  background: var(--color-primary); color: #fff;
  border-radius: 14px; padding: 16px; border: none;
  font-size: 17px; font-weight: 600; margin-top: 8px;
}
.action-btn::after { border: none; }
.action-btn[disabled] {
  background: var(--color-border); color: var(--color-text-secondary);
}

/* Footer */
.footer { margin-top: 40px; text-align: center; }
.skip-link {
  font-size: 14px; color: var(--color-text-secondary); line-height: 1;
}
.footer-text {
  display: block; font-size: 11px; color: var(--color-text-secondary);
  line-height: 1.8;
}
.footer-links { display: flex; justify-content: center; gap: 4px; }
.footer-link {
  font-size: 11px; color: var(--color-primary); line-height: 1.8;
}
