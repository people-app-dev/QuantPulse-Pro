<view class="page">
  <scroll-view class="tag-scroll" scroll-x>
    <text class="tag-chip {{activeTag === '' ? 'active' : ''}}" bindtap="onTagTap" data-tag="">全部</text>
    <text class="tag-chip {{activeTag === item ? 'active' : ''}}" wx:for="{{tags}}" wx:key="*this" bindtap="onTagTap" data-tag="{{item}}">{{item}}</text>
  </scroll-view>

  <view class="post-list">
    <post-card wx:for="{{posts}}" wx:key="_id" post="{{item}}" bind:like="onPostLike" />
    <view wx:if="{{posts.length === 0 && !loading}}" class="empty">暂无动态</view>
    <view wx:if="{{loading}}" class="empty">加载中...</view>
  </view>

  <view class="fab" bindtap="onCreatePost">+</view>
</view>
