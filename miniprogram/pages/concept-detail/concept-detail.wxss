@import '/styles/design-tokens.wxss';

page { background-color: var(--color-bg); }

.page {
  background-color: var(--color-bg);
  padding: var(--space-lg);
  min-height: 100vh;
  padding-bottom: 40px;
}

.loading-card {
  text-align: center;
  padding: 40px 0;
}
.loading-text {
  font-size: var(--font-body);
  color: var(--color-text-secondary);
}

.header-card {
  border-radius: 16px;
  padding: 28px var(--space-xl);
  margin-bottom: var(--space-md);
  background: linear-gradient(145deg, #007AFF, #5856D6);
  color: #fff;
}
.header-card.cat-stock {
  background: linear-gradient(145deg, #0056CC, #3F3BA7);
  color: #fff;
}
.header-card.cat-fund {
  background: linear-gradient(145deg, #E07800, #D1442E);
  color: #fff;
}
.header-card.cat-bond {
  background: linear-gradient(145deg, #248A3D, #1E7A34);
  color: #fff;
}
.header-card.cat-macro {
  background: linear-gradient(145deg, #8944AB, #6B3385);
  color: #fff;
}
.header-card.cat-finance {
  background: linear-gradient(145deg, #0066CC, #3A90C8);
  color: #fff;
}

.header-badge {
  font-size: 12px;
  font-weight: 600;
  display: inline-block;
  padding: 6px 14px;
  border-radius: 14px;
  background: rgba(255,255,255,0.22);
  margin-bottom: 14px;
  letter-spacing: 0.5px;
}
.header-title {
  font-size: 34px;
  font-weight: 800;
  display: block;
  margin-bottom: 10px;
  letter-spacing: -0.3px;
  text-shadow: 0 2px 12px rgba(0,0,0,0.4), 0 0 40px rgba(255,255,255,0.15);
}
.header-subtitle {
  font-size: 16px;
  line-height: 1.5;
  opacity: 0.9;
  display: block;
  font-weight: 400;
  text-shadow: 0 1px 4px rgba(0,0,0,0.3);
}

.detail-card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
}
.section-label {
  font-size: var(--font-caption);
  font-weight: 600;
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 1px;
  display: block;
  margin-bottom: var(--space-md);
}
.detail-text {
  font-size: 15px;
  color: var(--color-text-body);
  line-height: 1.8;
  white-space: pre-line;
}
.detail-loading {
  padding: 20px 0;
  text-align: center;
}
.detail-empty {
  padding: 16px 0;
  text-align: center;
}
.empty-detail-text {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.tags-card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--space-lg);
  margin-bottom: var(--space-md);
}
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
}
.tag-chip {
  font-size: var(--font-caption);
  color: var(--color-primary);
  background: rgba(0,122,255,0.08);
  padding: 4px 10px;
  border-radius: 14px;
}

.related-section {
  margin-bottom: var(--space-md);
}
.section-headline {
  font-size: var(--font-headline);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: var(--space-md);
}
.related-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-sm);
}

.related-card {
  background: var(--color-card);
  border-radius: var(--radius-card);
  padding: var(--space-md);
}
.related-badge {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
  display: inline-block;
  margin-bottom: 6px;
}
.related-badge.cat-stock {
  background: rgba(0,122,255,0.1);
  color: #007AFF;
}
.related-badge.cat-fund {
  background: rgba(255,149,0,0.1);
  color: #FF9500;
}
.related-badge.cat-bond {
  background: rgba(52,199,89,0.1);
  color: #34C759;
}
.related-badge.cat-macro {
  background: rgba(175,82,222,0.1);
  color: #AF52DE;
}
.related-badge.cat-finance {
  background: rgba(90,200,250,0.1);
  color: #5AC8FA;
}
.related-title {
  font-size: var(--font-body);
  font-weight: 600;
  color: var(--color-text-primary);
  display: block;
  margin-bottom: 4px;
}
.related-desc {
  font-size: var(--font-caption);
  color: var(--color-text-secondary);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
