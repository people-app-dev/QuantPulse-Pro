@import '/styles/design-tokens.wxss';
.page { padding: var(--space-lg); min-height: 100vh; padding-bottom: 60px; }
.post-detail { background: var(--color-card); border-radius: var(--radius-card); padding: var(--space-lg); margin-bottom: var(--space-lg); }
.post-content { font-size: var(--font-body); color: var(--color-text-body); line-height: 1.6; }
.post-images { display: flex; gap: 4px; margin-top: var(--space-sm); flex-wrap: wrap; }
.post-image { width: 100px; height: 100px; border-radius: 6px; }
.comments-section { margin-bottom: 60px; }
.section-title { font-size: var(--font-caption); color: var(--color-text-secondary); margin-bottom: var(--space-md); display: block; }
.comment { background: var(--color-card); border-radius: var(--radius-card); padding: var(--space-md); margin-bottom: var(--space-sm); }
.comment-content { font-size: var(--font-body); color: var(--color-text-body); }
.comment-time { font-size: var(--font-small); color: var(--color-text-secondary); margin-top: var(--space-xs); display: block; }
.empty { text-align: center; color: var(--color-text-secondary); font-size: var(--font-caption); padding: var(--space-xl); }
.comment-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 8px; padding: 8px 16px; background: #fff; border-top: 1px solid var(--color-border); }
.comment-input { flex: 1; background: var(--color-bg); border-radius: 20px; padding: 8px 12px; font-size: var(--font-body); }
.send-btn { background: var(--color-primary); color: #fff; border-radius: 20px; font-size: var(--font-caption); padding: 6px 16px; border: none; line-height: 1.5; }
